# Copy to `.env` for local development. Names only - never put real values in git.
# Document each variable in README or docs/architecture/ when you add one.

# EXAMPLE_API_URL=

# init-project / Bootstrap (non-interactive): true | false
# LAUNCHPAD_COLLECTS_PERSONAL_DATA=

# Better Auth and Google sign-in (DIDI-1001). For Node dev, prefer `.dev.vars` (see `.dev.vars.example`).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# PHYSIO_ALLOWED_GOOGLE_EMAILS=
# AUTH_BASE_URL=
# PHYSIO_USE_FAKE_GOOGLE_PROVIDER=
