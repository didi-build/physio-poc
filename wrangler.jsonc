{
  "name": "physio-poc",
  "main": "src/entry/worker.ts",
  "compatibility_date": "2025-10-29",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "d1_databases": [
    {
      "binding": "PHYSIO_DB",
      "database_name": "physio-poc",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./dist/ui",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "WEB_APP_BASE_URL": "https://physio-poc.diademshoukralla.workers.dev",
    "PHYSIO_USE_FAKE_GOOGLE_PROVIDER": "false",
  },
}
