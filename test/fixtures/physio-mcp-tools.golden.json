[
  {
    "name": "search_approved_exercises",
    "description": "Search approved exercises visible to the connector (read-only). Only approved exercises are returned. Supports limit (default 10, max 25) and an opaque cursor; responses include next_cursor when more results exist. When the query matches nothing, exercises is empty and search_link is the prefilled web app search URL (built from server config). Do not pass patient information.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Search text (exercise name or keywords). Do not include patient names, contact details, health card numbers, or dates of birth."
        },
        "category": {
          "type": "string",
          "enum": ["Stretching", "Strengthening"],
          "description": "Exercise library category filter."
        },
        "body_region": {
          "type": "string",
          "description": "Single body region label from the seeded list."
        },
        "prescription_type": {
          "type": "string",
          "enum": ["stretching", "isometric", "concentric", "eccentric"],
          "description": "Optional filter: exercises that can be prescribed with this type."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25,
          "default": 10,
          "description": "Maximum results to return (default 10, max 25)."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from a previous response next_cursor. Omit on the first page."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "share_link", "manage_url", "exercises"],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 4000,
          "description": "Plain text summary for the assistant. Do not include patient names, contact details, health card numbers, or dates of birth."
        },
        "share_link": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "HTTPS share link for the program when a published version exists or after publish. Empty string when no published link applies."
        },
        "manage_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "HTTPS link to manage the program in the web app (delete and link close are web app only in v1). Empty when no program applies."
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exercise_version_id", "exercise_name", "category"],
            "properties": {
              "exercise_version_id": {
                "type": "string"
              },
              "exercise_name": {
                "type": "string",
                "description": "Approved exercise display name."
              },
              "category": {
                "type": "string",
                "enum": ["Stretching", "Strengthening"],
                "description": "Exercise library category filter."
              },
              "body_regions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Body region labels from the seeded list."
              },
              "allowed_prescription_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["stretching", "isometric", "concentric", "eccentric"],
                  "description": "How this exercise is prescribed on this program row. Stretch exercises use stretching only. Strengthening exercises use isometric, concentric, or eccentric."
                },
                "description": "Prescription types allowed for this exercise on a program row."
              }
            }
          },
          "description": "Matching approved exercises, empty when none match."
        },
        "next_cursor": {
          "type": "string",
          "description": "Opaque cursor for the next page. Omit when there are no more results."
        },
        "search_link": {
          "type": "string",
          "format": "uri",
          "description": "Prefilled web app exercise search URL when the query returned zero approved exercises. Built from server-configured base URL."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exercises": {
                "type": "array",
                "maxItems": 0
              }
            },
            "required": ["exercises"]
          },
          "then": {
            "required": ["search_link"]
          }
        }
      ]
    }
  },
  {
    "name": "search_routines",
    "description": "Search routines: cookie-cutter programs for common ailments. Includes community library entries and personal copies. Supports limit (default 10, max 25) and an opaque cursor. Do not pass patient information.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Search text (routine name or keywords). Do not include patient names, contact details, health card numbers, or dates of birth."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25,
          "default": 10,
          "description": "Maximum results to return (default 10, max 25)."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from a previous response next_cursor. Omit on the first page."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "share_link", "manage_url", "routines"],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 4000,
          "description": "Plain text summary for the assistant. Do not include patient names, contact details, health card numbers, or dates of birth."
        },
        "share_link": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "HTTPS share link for the program when a published version exists or after publish. Empty string when no published link applies."
        },
        "manage_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "HTTPS link to manage the program in the web app (delete and link close are web app only in v1). Empty when no program applies."
        },
        "routines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["routine_id", "routine_name", "routine_version"],
            "properties": {
              "routine_id": {
                "type": "string"
              },
              "routine_name": {
                "type": "string",
                "maxLength": 80,
                "description": "Routine display name. Do not include patient names, contact details, health card numbers, or dates of birth."
              },
              "routine_version": {
                "type": "integer",
                "minimum": 1
              },
              "exercise_count": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "type": "string",
                "enum": ["community", "personal_copy"],
                "description": "Whether this hit is the community routine or a personal copy."
              }
            }
          },
          "description": "Matching routines, empty when none match."
        },
        "next_cursor": {
          "type": "string",
          "description": "Opaque cursor for the next page. Omit when there are no more results."
        }
      }
    }
  },
  {
    "name": "build_or_edit_program",
    "description": "Create or replace a program. Omit program_code to create; pass program_code to replace that program's full rows list (no incremental ops). Create from a routine with from_routine_id in one call; optional rows replaces the copied rows. Records source_routine_id on the program. Each row uses exercise_version_id or exercise_name, not both; the server resolves names and omits unresolved rows (no placeholder rows). Unresolved names appear in exercises_not_found with up to three candidates and a prefilled web app search link (URL built from server config). Publishing and link expiry use get_program_share_link_or_pdf. Closing a link stays in the web app. Do not include patient information in program_title or row_notes.",
