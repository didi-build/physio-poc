                            "type": "number"
                          }
                        },
                        "description": "Inclusive numeric range."
                      }
                    ]
                  }
                },
                "description": "Dose parameters for this program row. Only include keys that apply to the exercise and prescription type."
              },
              "row_notes": {
                "type": "string",
                "maxLength": 300,
                "description": "Optional notes about the exercise prescription on this row only. Do not include patient names, contact details, health card numbers, or dates of birth."
              }
            },
            "description": "One saved program row. Snapshots params and text; unresolved names are omitted from rows and listed under exercises_not_found."
          }
        },
        "exercises_not_found": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested_exercise_name", "web_app_exercise_search_url"],
            "properties": {
              "requested_exercise_name": {
                "type": "string",
                "maxLength": 100,
                "description": "Exercise name that could not be resolved to exactly one approved exercise. Do not include patient names, contact details, health card numbers, or dates of birth."
              },
              "candidate_matches": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["exercise_version_id", "exercise_name"],
                  "properties": {
                    "exercise_version_id": {
                      "type": "string"
                    },
                    "exercise_name": {
                      "type": "string"
                    }
                  }
                },
                "description": "Up to three similar approved exercises when the name was ambiguous."
              },
              "web_app_exercise_search_url": {
                "type": "string",
                "format": "uri",
                "description": "Web app exercise search URL with the query prefilled, built from server-configured web app base URL and the requested name."
              }
            }
          },
          "description": "Exercise names that were not resolved to exactly one approved exercise."
        }
      }
    }
  },
  {
    "name": "get_program_share_link_or_pdf",
    "description": "Read or publish a program share link and PDF. Never publishes unless publish is true. Set publish to true only after the practitioner explicitly confirms in the conversation. Without publish, returns draft and published (each null or a version snapshot). When a published version exists, also returns its share_link, pdf_url, and expires_at; share_link and pdf_url are empty strings when nothing is published yet. The summary should ask which version the practitioner wants and whether to publish with defaults or overrides. With publish true, publishes the current draft and returns share_link, pdf_url, and expires_at (republishing replaces the live version at the same share link). Optional overrides.expires_in sets expiry (1_week, 30_days, 90_days, 1_year, never, or custom_date with overrides.custom_date); omit overrides to use the practitioner default. Lookup by program_code or program_title; title works only when exactly one program matches, otherwise ambiguous_program_matches is returned. Deleting a link is web app only.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "program_code": {
          "type": "string",
          "pattern": "^PRG-[A-Z0-9]+$",
          "description": "Stable program code assigned by the system (for example PRG-7K3Q)."
        },
        "program_title": {
          "type": "string",
          "maxLength": 80,
          "description": "Non-identifying program title the practitioner uses to recognise this program later. Do not include patient names, contact details, health card numbers, or dates of birth."
        },
        "publish": {
          "type": "boolean",
          "default": false,
          "description": "When false, read only. When true, publish the current draft after explicit practitioner confirmation in chat."
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expires_in": {
              "type": "string",
              "enum": [
                "1_week",
                "30_days",
                "90_days",
                "1_year",
                "never",
                "custom_date"
              ],
              "description": "Share link expiry for this publish. Omit overrides entirely to use the practitioner default."
            },
            "custom_date": {
              "type": "string",
              "format": "date",
              "description": "Required when expires_in is custom_date. Any calendar date from tomorrow onward per product rules."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "expires_in": {
                    "const": "custom_date"
                  }
                },
                "required": ["expires_in"]
              },
              "then": {
                "required": ["custom_date"]
              }
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": ["program_code"]
        },
        {
          "required": ["program_title"]
        }
      ]
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "share_link",
        "manage_url",
        "pdf_url",
        "draft",
        "published"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 4000,
          "description": "Plain text summary for the assistant. Do not include patient names, contact details, health card numbers, or dates of birth."
        },
        "share_link": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "HTTPS share link for the program when a published version exists or after publish. Empty string when no published link applies."
        },
        "pdf_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "HTTPS URL of the server-rendered program PDF. Never inline bytes. Empty when no published PDF applies."
        },
        "manage_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "HTTPS link to manage the program in the web app (delete and link close are web app only in v1). Empty when no program applies."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the published share link expires. Omitted when there is no published link."
        },
        "draft": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "updated_at"],
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Monotonic program version number for this snapshot."
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When this version was last saved."
                }
              }
            }
          ],
          "description": "Null when that side (draft or published) does not exist."
        },
        "published": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "updated_at"],
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Monotonic program version number for this snapshot."
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When this version was last saved."
                }
              }
            }
          ],
          "description": "Null when that side (draft or published) does not exist."
        },
        "program_code": {
          "type": "string",
          "pattern": "^PRG-[A-Z0-9]+$",
          "description": "Stable program code assigned by the system (for example PRG-7K3Q)."
        },
        "program_title": {
          "type": "string",
          "maxLength": 80,
          "description": "Non-identifying program title the practitioner uses to recognise this program later. Do not include patient names, contact details, health card numbers, or dates of birth."
        },
        "ambiguous_program_matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["program_code", "program_title", "updated_at"],
            "properties": {
              "program_code": {
                "type": "string",
                "pattern": "^PRG-[A-Z0-9]+$",
                "description": "Stable program code assigned by the system (for example PRG-7K3Q)."
              },
              "program_title": {
                "type": "string",
                "maxLength": 80,
                "description": "Non-identifying program title the practitioner uses to recognise this program later. Do not include patient names, contact details, health card numbers, or dates of birth."
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "description": "When this program was last updated."
              }
            }
          },
          "description": "When program_title matches more than one program, list candidates and ask for program_code."
        }
      }
    }
  }
]
